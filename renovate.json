{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "commitHourlyLimit": 2,
  "major": {
    "dependencyDashboardApproval": true
  },
  "pre-commit": {
    "enabled": true
  }
}
